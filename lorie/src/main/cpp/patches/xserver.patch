+/* Private, capability-negotiated delivery to the exact event selection which
+ * opted in.  Standard CompleteNotify remains broadcast according to the
+ * Present protocol; this additional kind must never reach legacy clients. */
+Bool
+present_lorie_get_feedback_target(WindowPtr window, ClientPtr client,
+                                  present_lorie_feedback_target_rec *target)
+{
+    present_window_priv_ptr window_priv = present_window_priv(window);
+    present_event_ptr event;
+
+    if (!window_priv || !target)
+        return FALSE;
+
+    for (event = window_priv->events; event; event = event->next) {
+        if (event->client == client &&
+            (event->mask & PresentCompleteNotifyMask)) {
+            *target = (present_lorie_feedback_target_rec) {
+                .eid = event->id,
+                .window_generation = window_priv->lorie_generation,
+                .event_generation = event->lorie_generation,
+            };
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+Bool
+present_lorie_send_actual_notify(WindowPtr window,
+                                 const present_lorie_feedback_target_rec *target,
+                                 CARD8 mode, CARD32 serial, uint64_t ust,
+                                 uint64_t tag)
+{
+    present_window_priv_ptr window_priv = present_window_priv(window);
+    present_event_ptr event;
+
+    if (!window_priv || !target || !target->eid ||
+        window_priv->lorie_generation != target->window_generation)
+        return FALSE;
+
+    for (event = window_priv->events; event; event = event->next) {
+        xPresentCompleteNotify cn;
+
+        if (event->id != target->eid ||
+            event->lorie_generation != target->event_generation ||
+            !(event->mask & PresentCompleteNotifyMask))
+            continue;
+
+        cn = (xPresentCompleteNotify) {
+            .type = GenericEvent,
+            .extension = present_request,
+            .length = (sizeof(xPresentCompleteNotify) - 32) >> 2,
+            .evtype = PresentCompleteNotify,
+            .kind = LoriePresentCompleteKindActual,
+            .mode = mode,
+            .eid = event->id,
+            .window = window->drawable.id,
+            .serial = serial,
+            .ust = ust,
+            .msc = tag,
+        };
+        WriteEventsToClient(event->client, 1, (xEvent *) &cn);
+        return TRUE;
+    }
+
+    return FALSE;
+}
+
+/* Private backend-capacity feedback.  This says only that the renderer has
+ * finished sampling, or terminally retired, the root contents for this
+ * Present.  It is not presentation or allocation-release feedback. */
+Bool
+present_lorie_send_backend_release_notify(
+    WindowPtr window, const present_lorie_feedback_target_rec *target,
+    CARD8 mode, CARD32 serial, uint64_t tag, uint64_t deadline_us,
+    uint64_t expected_us, uint64_t opportunity_ust,
+    uint64_t opportunity_msc)
+{
+    present_window_priv_ptr window_priv = present_window_priv(window);
+    present_event_ptr event;
+
+    if (!window_priv || !target || !target->eid ||
+        window_priv->lorie_generation != target->window_generation)
+        return FALSE;
+
+    for (event = window_priv->events; event; event = event->next) {
+        xPresentCompleteNotify cn;
+
+        if (event->id != target->eid ||
+            event->lorie_generation != target->event_generation ||
+            !(event->mask & PresentCompleteNotifyMask))
+            continue;
+
+        if (mode == LoriePresentBackendReleaseConsumed &&
+            deadline_us && expected_us && opportunity_ust &&
+            opportunity_msc) {
+            xPresentCompleteNotify timeline = {
+                .type = GenericEvent,
+                .extension = present_request,
+                .length = (sizeof(xPresentCompleteNotify) - 32) >> 2,
+                .evtype = PresentCompleteNotify,
+                .kind = LoriePresentCompleteKindTimeline,
+                .mode = LoriePresentTimelineModeExact,
+                .eid = event->id,
+                .window = window->drawable.id,
+                .serial = serial,
+                .ust = deadline_us,
+                .msc = expected_us,
+            };
+            WriteEventsToClient(event->client, 1, (xEvent *) &timeline);
+        }
+
+        cn = (xPresentCompleteNotify) {
+            .type = GenericEvent,
+            .extension = present_request,
+            .length = (sizeof(xPresentCompleteNotify) - 32) >> 2,
+            .evtype = PresentCompleteNotify,
+            .kind = LoriePresentCompleteKindBackendRelease,
+            .mode = mode,
+            .eid = event->id,
+            .window = window->drawable.id,
+            .serial = serial,
+            /* The preceding private event carries deadline/expected time.
+             * This event retains the ownership boundary and contributes the
+             * exact X-selection opportunity UST/MSC used to correlate that
+             * pair. */
+            .ust = mode == LoriePresentBackendReleaseConsumed ?
+                   opportunity_ust : 0,
+            .msc = mode == LoriePresentBackendReleaseConsumed ?
+                   opportunity_msc : tag,
+        };
+        WriteEventsToClient(event->client, 1, (xEvent *) &cn);
+        return TRUE;
+    }
+
+    return FALSE;
+}
